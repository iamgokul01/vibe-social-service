{
  "name": "vibesocial-backend",
  "version": "1.0.0",
  "private": true,
  "description": "VibeSocial role-based social analytics platform API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "bootstrap": "ts-node src/database/bootstrap/bootstrap-admin.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "test:cov": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "^18.0.3",
    "helmet": "8.3.0",
    "mysql2": "3.24.6",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "^2.18.1",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/passport-jwt": "4.0.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "7.2.1",
    "cross-env": "^10.1.0",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "<rootDir>/../test/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
